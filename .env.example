# ── Frontend (safe to expose: anon key is protected by RLS) ──────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Leave both empty to run the app in Demo Mode (local seeded data, no backend).

# ── Edge Function secrets (NEVER put these in the frontend) ──────────────
# Set with:  supabase secrets set --env-file supabase/.env.local
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# SITE_URL=https://your-app.vercel.app
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically in Edge Functions)

# ── Integration tests (tests/integration) — use a THROWAWAY dev project ──
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
